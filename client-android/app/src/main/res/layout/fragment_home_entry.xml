<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg4"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_section_card"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="今天吃什么？"
            android:textColor="@color/ui_text_main"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="可以直接进入菜单，也可以先让系统按口味和饮食需求推荐。"
            android:textColor="@color/ui_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_entry_order"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/selector_loginactivity_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="直接点餐"
            android:textColor="@color/ui_text_inverse"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_entry_recommend"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/selector_order_action_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="智能推荐"
            android:textColor="@color/ui_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
