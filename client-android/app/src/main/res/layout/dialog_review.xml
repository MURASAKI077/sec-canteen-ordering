<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ui_surface"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tv_review_title"
        style="@style/UiTextTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="评价订单" />

    <TextView
        android:id="@+id/tv_review_dish"
        style="@style/UiTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ui_text_secondary" />

    <RatingBar
        android:id="@+id/rb_review_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:numStars="5"
        android:rating="5"
        android:stepSize="1" />

    <EditText
        android:id="@+id/et_review_content"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/edittext"
        android:gravity="top|start"
        android:hint="写下这次用餐感受，最多 200 字"
        android:inputType="textMultiLine"
        android:maxLength="200"
        android:minLines="3"
        android:padding="10dp"
        android:textColor="@color/ui_text_main"
        android:textColorHint="@color/ui_text_hint"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_review_cancel"
            style="@style/UiButtonCommon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="取消" />

        <Button
            android:id="@+id/btn_review_submit"
            style="@style/UiButtonCommon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="提交评价" />
    </LinearLayout>
</LinearLayout>
